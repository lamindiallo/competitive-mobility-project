<h1>Compare two clubs</h1>
<p class="lede">Put any two clubs side by side — from the same league or from different countries.</p>
<div class="pickers"><label>First club<input id="a" list="cl" placeholder="Type a club" autocomplete="off"></label><label>Second club<input id="b" list="cl" placeholder="Type a club" autocomplete="off"></label></div>
<datalist id="cl"></datalist>
<div id="out"></div>
<details class="how"><summary>How to read this</summary><div><p>Each line is a club's final position every season. To put clubs from different countries on one chart, each division is drawn as a band of the same height: the top of a band is first place, the bottom is last place. England's third and fourth divisions are covered; elsewhere the chart stops at the second division.</p></div></details>
<script>
(async()=>{const D=await (await fetch('data/clubs.json')).json();const C=D.clubs;const by={};const lab=x=>x.n+' ('+({ENG:'England',ESP:'Spain',ITA:'Italy',GER:'Germany',FRA:'France'})[x.c]+')';
C.forEach(x=>by[lab(x)]=x);const dl=document.getElementById('cl');Object.keys(by).sort().forEach(k=>{const o=document.createElement('option');o.value=k;dl.appendChild(o)});
const P=new URLSearchParams(location.search);const bs=s=>C.find(x=>x.s===s);const A=document.getElementById('a'),B=document.getElementById('b');
if(P.get('a')&&bs(P.get('a')))A.value=lab(bs(P.get('a')));if(P.get('b')&&bs(P.get('b')))B.value=lab(bs(P.get('b')));
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));const sea=s=>s+'/'+String((s+1)%100).padStart(2,'0');
const ord=n=>n+(n%100>=11&&n%100<=13?'th':({1:'st',2:'nd',3:'rd'}[n%10]||'th'));
function draw(){const a=by[A.value],b=by[B.value];const o=document.getElementById('out');if(!a&&!b){o.innerHTML='';return}
 const xs=[a,b].filter(Boolean);const W=760,H=320,l=16,r=16,t=12,bt=30;const lo=Math.min(...xs.map(x=>x.y[0][0])),hi=2025;
 const tiers=Math.max(...xs.map(x=>x.c==='ENG'&&x.y.some(z=>z[1]>2)?4:2));const X=s=>l+(s-lo)/(hi-lo)*(W-l-r),Y=v=>t+v/tiers*(H-t-bt);
 let s='<svg viewBox="0 0 '+W+' '+H+'" class="chart wide" role="img">';const names=['Top division','Second division','Third division','Fourth division'];
 for(let i=0;i<tiers;i++){if(i%2==0)s+='<rect class="tierband" x="'+l+'" y="'+Y(i)+'" width="'+(W-l-r)+'" height="'+(Y(i+1)-Y(i))+'"/>';s+='<text class="tierlab" x="'+(l+6)+'" y="'+(Y(i)+16)+'">'+names[i]+'</text>';}
 for(let y=hi,i=0;y>=lo;y-=4,i++)s+='<text class="ax'+(i%2?' alt':'')+'" x="'+X(y)+'" y="'+(H-8)+'" text-anchor="middle">'+sea(y)+'</text>';
 xs.forEach((x,j)=>{const cls=j?'2':'1';let seg=[],prev=null;const flush=()=>{if(seg.length>1)s+='<polyline class="s'+cls+'" points="'+seg.join(' ')+'"/>';seg=[]};
  x.y.forEach(([yy,ti,po,lv])=>{if(prev!==null&&yy!==prev+1)flush();seg.push(X(yy).toFixed(1)+','+Y(lv+.02).toFixed(1));prev=yy});flush();
  x.y.forEach(([yy,ti,po,lv])=>{s+='<circle class="d'+cls+'" cx="'+X(yy).toFixed(1)+'" cy="'+Y(lv+.02).toFixed(1)+'" r="3.5"/><circle class="hit" cx="'+X(yy).toFixed(1)+'" cy="'+Y(lv+.02).toFixed(1)+'" r="9" data-tip="'+esc(x.n+', '+sea(yy)+': '+ord(po)+' in '+D.the[x.c][ti])+'"/>'});});
 s+='</svg>';
 const row=(k,f)=>'<tr><th>'+k+'</th>'+xs.map(x=>'<td class="n">'+f(x)+'</td>').join('')+'</tr>';
 const last=x=>{const z=x.y[x.y.length-1];return z[0]===2025?ord(z[2])+' in '+D.the[x.c][z[1]]:'—'};
 o.innerHTML='<div class="chartbox"><div class="legend">'+xs.map((x,j)=>'<span style="--c:var('+(j?'--cmp':'--acc')+')">'+esc(x.n)+'</span>').join('')+'</div>'+s+'</div>'+
 '<div class="scroll"><table class="t"><tr><th></th>'+xs.map(x=>'<th class="n"><a href="clubs/'+x.s+'.html">'+esc(x.n)+'</a></th>').join('')+'</tr>'+
 row('2025/26',last)+row('Seasons covered',x=>x.y.length)+row('Seasons in the top division',x=>x.tf)+row('League titles',x=>x.t)+row('Top-four finishes',x=>x.f)+row('Promotions',x=>x.u)+row('Relegations',x=>x.d)+'</table></div>';
 const u=new URL(location);if(a)u.searchParams.set('a',a.s);if(b)u.searchParams.set('b',b.s);history.replaceState(null,'',u);document.querySelectorAll('svg [data-tip]').forEach(n=>n.setAttribute('tabindex','0'));}
A.addEventListener('change',draw);B.addEventListener('change',draw);A.addEventListener('input',draw);B.addEventListener('input',draw);draw();})();
</script>
